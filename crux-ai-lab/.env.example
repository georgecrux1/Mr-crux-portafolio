# ===== CRUX AI LAB — copia este archivo como .env =====
# Las claves solo viven aquí (servidor). El navegador nunca las ve.

# --- Claves de API (opcionales) ---
# Anthropic Claude: API DE PAGO. https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI u otra API compatible (de pago). Para Ollama local no hace falta.
OPENAI_API_KEY=
# Token de tu propio chatbot (pon este NOMBRE en "Variable del token")
# MI_BOT_TOKEN=

# --- Seguridad del panel ---
# Si publicas la app en Internet, DEFINE un token largo y aleatorio.
APP_ACCESS_TOKEN=
# Hosts permitidos como objetivo, separados por comas (vacío = cualquiera; solo en local)
ALLOWED_TARGET_HOSTS=
# true en local (Ollama, bots en localhost). Pon false si publicas la app.
ALLOW_PRIVATE_TARGETS=true

# --- Límites de consumo ---
MAX_TESTS_PER_RUN=500
MAX_REQUESTS_PER_MINUTE=120
MAX_CONCURRENCY=4
DEFAULT_TOKEN_BUDGET=200000
REQUEST_TIMEOUT_SECONDS=60

# --- Base de datos ---
# CRUX_DB_PATH=./data/crux.db
